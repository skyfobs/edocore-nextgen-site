apiVersion: v1
kind: Secret
metadata:
  name: educore-secrets
  namespace: educore
type: Opaque
stringData:
  # IMPORTANT: Copy this file to secret.yaml and add your real values
  # secret.yaml is in .gitignore and won't be committed
  
  # Replace with your Telegram bot token
  TELEGRAM_BOT_TOKEN: "YOUR_TELEGRAM_BOT_TOKEN_HERE"
  
  # Replace with your Telegram chat ID (include the minus sign if negative)
  TELEGRAM_CHAT_ID: "YOUR_TELEGRAM_CHAT_ID_HERE"

---
# Instructions:
# 
# 1. Copy this template:
#    cp secret.yaml.template secret.yaml
#
# 2. Edit secret.yaml with your real values:
#    nano secret.yaml
#
# 3. Apply to cluster:
#    kubectl apply -f secret.yaml
#
# 4. Verify:
#    kubectl get secret educore-secrets -n educore
#
# Note: secret.yaml is in .gitignore and won't be committed to Git
